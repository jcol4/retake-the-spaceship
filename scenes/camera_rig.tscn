[gd_scene load_steps=2 format=3 uid="uid://ccamerarig01"]

[ext_resource type="Script" path="res://scripts/camera_rig.gd" id="1_script"]

[node name="CameraRig" type="Node3D"]
script = ExtResource("1_script")

; Plain offset rather than a SpringArm3D: zoom is driven by Camera3D.size
; (see camera_rig.gd), not by moving the camera along a boom, and the boom's
; collision_mask was already 0. The camera sits back along the pivot's local
; +Z purely to keep geometry off the near plane.
[node name="Camera3D" type="Camera3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 18)
projection = 1
; Vertical world extent on screen at the closest zoom (camera_rig.gd's
; MIN_ZOOM_SIZE, which mirrors this value — keep the two in sync). Chosen
; against the XCOM reference framing in character-art-plan.md, which puts a
; character at 15-20% of viewport height at this zoom level; scrolling out
; trades that legibility for more of the room, up to MAX_ZOOM_SIZE.
;
; 10.5, corrected down from 12. THE FORESHORTENING IS THE WHOLE CORRECTION: an
; upright figure seen at PITCH does not occupy its full height on screen, it
; occupies height * cos(PITCH) = 1.92 * 0.8165 = 1.568 m. The old 12 was picked
; from 1.92 / 12 = 16%, which omitted that cosine and was really 13.1% — under
; the reference band, not inside it. 1.568 / 10.5 = 14.9%.
;
; The 16% figure WAS accurate for the code placeholder, which is drawn filling
; its canvas and so is foreshortened by nothing. It stopped being accurate the
; moment rendered art landed. Mirrored by render_sprites.py GAME_CAMERA_SIZE,
; which is where the same arithmetic is printed at render time.
;
; At 10.5 the view is roughly 7 by 12 tiles, which still holds a whole
; compartment. Scrolling out further is a legibility/coverage tradeoff the
; player now makes themselves; see MAX_ZOOM_SIZE in camera_rig.gd.
size = 10.5
far = 200.0
