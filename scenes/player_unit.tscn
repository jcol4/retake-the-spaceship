[node name="PlayerUnit" type="Node3D" unique_id=1752049843 groups=["player_units", "units"]]
script = ExtResource("1_script")

; canvas_height mirrors render_sprites.py CANVAS_HEIGHT. foot_anchor is the
; WORLD ORIGIN's row, 1 - FLOOR_MARGIN / CANVAS_HEIGHT = 1 - 0.45 / 2.56, which
; render_sprites.py prints. Under the ortho sprite camera that row is where the
; model's true ground point lands in every facing, pose and frame, so it is
; exact rather than measured.
;
; It used to be row 17, the mean lowest opaque row over the idle facings, and
; that was the float: the lowest boot is planted IN FRONT of the origin, which
; projects lower on screen, so pinning it to the tile centre lifted the whole
; merc ~28 px. The origin was rejected then because boots planted toward the
; camera reach up to 36 px below it and a flat card drew them under the floor.
; body_depth_merc.tres fixes that: each pixel depth-tests at its real distance
; from the camera (UnitVisual DEPTH_LAYER_SUFFIX), so those boots draw in front
; of the floor they stand on.
;
; `flash` is the muzzle-flash OVERLAY, and it is LAST in `layers` because layers
; draw back to front. It is the one layer that is not the character: it carries a
; single frame of `fire_shoot` and shows nothing the rest of the time, which
; UnitVisual._play already does for any layer with no art for the current pose.
;
; layer_canvas_scale says its art is drawn on a canvas twice the size, and the
; reason is that the flash does not FIT in 2.56 m -- the barrel tip is 29 px from
; the top edge of the frame facing nw. `render_sprites.py --flash` renders it
; through the same camera at the same centre with double the extent and double
; the resolution, so metres-per-pixel is unchanged. canvas_height and foot_anchor
; above are still the body's and are not restated here: UnitVisual derives this
; layer's own from the 2.0, which is what keeps the two from drifting apart.
[node name="Visual" type="Node3D" parent="." unique_id=208281447]
script = ExtResource("3_visual")
layers = Array[StringName]([&"body", &"flash"])
variant = &"merc"
canvas_height = 2.56
foot_anchor = Vector2(0.5, 0.82421875)
layer_canvas_scale = {
&"flash": 2.0
}

