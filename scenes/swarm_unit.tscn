[gd_scene load_steps=4 format=3 uid="uid://cswarmunit01"]

[ext_resource type="Script" path="res://scripts/swarm_unit.gd" id="1_script"]
[ext_resource type="Script" path="res://scripts/unit_visual.gd" id="2_visual"]

[sub_resource type="CapsuleShape3D" id="capsule_shape"]
radius = 0.42
height = 1.8

[node name="SwarmUnit" type="Node3D" groups=["enemy_units", "units"]]
script = ExtResource("1_script")
; A third of the soldier's 4.5, so the swarm visibly reads as outrunnable —
; which is the whole point of Fodder (Sec 11.3). Unlike the soldier's, this
; number was never fitted to a clip: the shamble cycle is drawn to read at 1.5.
move_speed = 1.5

; ONE layer. No weapon layer — the swarm has no ranged attack at all (Sec 11.4)
; — and no helmet, for the obvious reason. The head is not split out either: the
; swarm is drawn as a single figure, and an empty `head` layer would not stay
; empty, it would fall back to placeholder art and paint a disc over the face.
; Splitting the head back out is an art decision, and costs a layer name here.
[node name="Visual" type="Node3D" parent="."]
script = ExtResource("2_visual")
layers = Array[StringName]([&"body"])
variant = &"swarm"
has_light = false

; Layer 2, mask 0 — nothing raycasts against it today (grid_manager's LOS and
; lighting occlusion both query layer 1 map geometry only), so this is a body
; volume rather than a gameplay surface.
[node name="Body" type="StaticBody3D" parent="."]
collision_layer = 2
collision_mask = 0

[node name="Collision" type="CollisionShape3D" parent="Body"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.9, 0)
shape = SubResource("capsule_shape")

[node name="NameLabel" type="Label3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 2.2, 0)
billboard = 1
text = "Swarm"
