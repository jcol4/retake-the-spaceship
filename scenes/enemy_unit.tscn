[gd_scene load_steps=4 format=3 uid="uid://cenemyunit01"]

[ext_resource type="Script" path="res://scripts/enemy_unit.gd" id="1_script"]
[ext_resource type="Script" path="res://scripts/unit_visual.gd" id="2_visual"]

[sub_resource type="CapsuleShape3D" id="capsule_shape"]
radius = 0.35
height = 1.8

[node name="EnemyUnit" type="Node3D" groups=["enemy_units", "units"]]
script = ExtResource("1_script")

; No helmet layer: whatever this thing is, it is not wearing one. The layer set
; is per-character for exactly this reason — an absent layer costs no art and no
; code, where a hardcoded four would have needed an empty sheet drawn for it.
;
; has_light false because aliens rely on their own senses rather than a mounted
; light (Sec 5.2), which is the same reason EnemyUnit clears has_flashlight.
[node name="Visual" type="Node3D" parent="."]
script = ExtResource("2_visual")
layers = Array[StringName]([&"body", &"head", &"weapon"])
variant = &"alien"
has_light = false

[node name="Body" type="StaticBody3D" parent="."]
collision_layer = 2
collision_mask = 0

[node name="Collision" type="CollisionShape3D" parent="Body"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.9, 0)
shape = SubResource("capsule_shape")

[node name="NameLabel" type="Label3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 2.2, 0)
billboard = 1
text = "Alien"
