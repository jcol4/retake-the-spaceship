[gd_scene format=3 uid="uid://ccharbase01"]

[ext_resource type="Script" path="res://scripts/unit_visual.gd" id="1_visual"]
[ext_resource type="PackedScene" path="res://assets/soldier_mixamo.glb" id="2_soldier"]
[ext_resource type="PackedScene" path="res://assets/rifle.glb" id="3_rifle"]
[ext_resource type="Script" path="res://scripts/flashlight_beam.gd" id="4_beam"]
[ext_resource type="Script" path="res://scripts/weapon_mount.gd" id="5_mount"]
[ext_resource type="Script" path="res://scripts/aimed_light.gd" id="6_light"]
[ext_resource type="Script" path="res://scripts/aim_pitch.gd" id="7_aimpitch"]

; NOTE FOR ANY EDITOR SESSION: scrubbing the AnimationPlayer writes the current
; pose onto Skeleton3D's bone properties, and saving the scene bakes them in as
; a `Skeleton3D` override node holding ~100 `bones/N/...` lines. That frozen pose
; then fights every clip at runtime. If you scrub to judge the weapon fit, close
; the scene WITHOUT saving, or delete that override node before you commit.
[node name="Visual" type="Node3D"]
script = ExtResource("1_visual")
; The flashlight moved off the muzzle onto the helmet, so the soldier-shaped
; default on this export ("…/RifleMount/rifle/Muzzle/Flashlight") no longer
; resolves. Written out rather than left to fall back to null, so this reads as
; a decision instead of an oversight.
flashlight_path = NodePath("soldier/Rig/Skeleton3D/Helmet/Flashlight")

; Yawed 180 degrees because the Mixamo mesh faces +Z and Godot's forward is -Z.
; Measured, not guessed: tools/_debug_facing.gd reported the model's shoulder
; forward as (+0.01, +1.00) in the idle pose.
;
; This correction belongs HERE, at the asset boundary, rather than as a sign
; flip in _yaw_toward or face_toward: the movement and aim code is already
; correct in Godot's convention, and every consumer of unit facing (LOS, the
; flashlight cone in lighting_manager.gd) reads the unit node rather than the
; mesh. Negating things downstream would spread one asset quirk across gameplay.
[node name="soldier" parent="." instance=ExtResource("2_soldier")]
transform = Transform3D(-1, 0, 0, 0, 1, 0, 0, 0, -1, 0, 0, 0)

; MUST stay ABOVE RifleMount in this file. Both hang off the same
; skeleton_updated signal, Godot fires it in tree order, and this one pitches the
; Spine2 bone that moves BOTH hands. Ordered the other way, RifleMount would read
; the hand positions a frame before the pitch was applied to them, and the barrel
; would lag the body by one frame on every vertical aim.
;
; pitch_flip measured, not guessed: tools/shot_sheet.gd with SHEET_MODE=aim
; renders the same pose against a target swept from 1.6 m below the shooter to
; 2.6 m above. Unflipped, the barrel rose as the target FELL and fell as it
; rose -- inverted across all six heights. This cannot be seen in the editor at
; all: aim_pitch.gd holds _has_target = false until something calls aim_at() at
; runtime, so scrubbing the AnimationPlayer shows a node doing nothing.
;
; pitch_flip, pitch_axis and max_pitch_deg now drive only the LEGACY bone-aiming
; path. aim_bore defaults to true, which aims the barrel rather than the spine
; bone and corrects yaw as well as pitch, so none of those three are read. They
; are left set so flipping aim_bore off restores the previous behaviour intact.
;
; mount_path is likewise left at its default "../RifleMount", which resolves
; because both nodes are siblings under Skeleton3D -- worth noting only because
; it means this fix needed no edit to the node list, and this scene has twice
; been gutted by editor rewrites.
[node name="AimPitch" type="Node3D" parent="soldier/Rig/Skeleton3D" index="1"]
script = ExtResource("7_aimpitch")
pitch_flip = true

; Driven from BOTH hands by weapon_mount.gd, not parented to one bone.
;
; A BoneAttachment3D on hand.R alone cannot keep a rifle looking held: barrel
; direction then comes entirely from that bone's roll, and Mixamo clips are
; separate mocap takes with no rifle in the actor's hand. A mount solved exact in
; aim_hold left the barrel 43 deg off in idle. Two hands are stable where one is
; not — see the script's header.
;
; grip_offset is MEASURED, not eyeballed — tools/solve_grip_offset.gd. Without it
; the mount puts the rifle's trigger at the right hand's BONE ORIGIN, which sits
; inside the wrist; a fist actually closes about 102 mm further out, so the
; weapon hung off the hand by that much.
;
; The tool fits a circle through each finger's four joints (projected onto the
; plane perpendicular to the knuckle line) and takes the consensus centre as the
; axis of whatever the hand is gripping. The right INDEX finger is excluded: it
; lies extended on the trigger rather than wrapped, so its curve describes
; trigger reach and not the grip.
;
; Agreed to 1 mm with the same measurement taken independently in Blender
; (tools/measure_grip_pose.py, 103 mm), and varies only 17.9 mm across the nine
; weapon-holding clips — which is the support lock in build_anims.py doing its
; job. Re-run the tool if the rifle's pistol grip ever moves.
;
; grip_rotation stays zero on purpose: the measured grip axis IS the hand's X
; axis, which is already what weapon_mount.gd uses for the weapon's up. The
; orientation was never wrong, only the translation.
;
; The mount writes its own global_transform, so the 0.01 scale on the Rig node
; does not have to be compensated here; the rifle below is plain identity.
[node name="RifleMount" type="Node3D" parent="soldier/Rig/Skeleton3D" index="2"]
script = ExtResource("5_mount")
grip_offset = Vector3(0.0211, 0.0964, -0.1334)

; Identity: the mount above already puts -Z down the barrel with the sights up,
; and rifle.glb is authored with its own -Z down the bore, so there is nothing
; left to correct here. The Muzzle node inside the GLB is exported by
; tools/import_rifle.py at the measured barrel tip, so it tracks the barrel
; length automatically instead of being a coordinate copied into this file.
[node name="rifle" parent="soldier/Rig/Skeleton3D/RifleMount" instance=ExtResource("3_rifle")]

; Helmet mount for the flashlight, replacing the old muzzle mount.
;
; Nothing is parented INSIDE the rifle GLB instance any more. That nesting
; (rifle/Muzzle/Flashlight/Beam) was silently dropped twice by the editor when
; the instance's dependencies were mid-reimport, taking the light and beam with
; it. Hanging off a bone the character always has cannot fail that way.
;
; The 0.01 scale on Rig does not reach the light: aimed_light.gd sets top_level
; and rebuilds its own global_transform from an ORTHONORMALIZED basis, taking
; only global_position from here. So this node supplies a point on the helmet
; and nothing else.
[node name="Helmet" type="BoneAttachment3D" parent="soldier/Rig/Skeleton3D" index="3"]
bone_name = "Head"

; Position follows the helmet, orientation follows the UNIT — see aimed_light.gd.
; LightingManager derives which tiles a unit lights from unit facing, so a beam
; pointing anywhere else would make the screen disagree with the rules.
;
; spot_angle stays at 45 (a 90 degree cone) to match LightingManager's
; FLASHLIGHT_CONE_DEGREES: what you see lit is what the unit can actually see by.
[node name="Flashlight" type="SpotLight3D" parent="soldier/Rig/Skeleton3D/Helmet"]
script = ExtResource("6_light")
light_color = Color(0.94, 0.96, 1, 1)
light_energy = 7.0
light_volumetric_fog_energy = 3.0
shadow_enabled = true
shadow_blur = 0.6
spot_range = 9.0
spot_angle = 45.0
spot_attenuation = 1.5
spot_angle_attenuation = 2.5

[node name="Beam" type="MeshInstance3D" parent="soldier/Rig/Skeleton3D/Helmet/Flashlight"]
script = ExtResource("4_beam")
