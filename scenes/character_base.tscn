[gd_scene format=3 uid="uid://ccharbase01"]

[ext_resource type="Script" path="res://scripts/unit_visual.gd" id="1_visual"]
[ext_resource type="PackedScene" path="res://assets/soldier_mixamo.glb" id="2_soldier"]
[ext_resource type="PackedScene" path="res://assets/rifle.glb" id="3_rifle"]
[ext_resource type="Script" path="res://scripts/flashlight_beam.gd" id="4_beam"]
[ext_resource type="Script" path="res://scripts/weapon_mount.gd" id="5_mount"]
[ext_resource type="Script" path="res://scripts/aimed_light.gd" id="6_light"]

[node name="Visual" type="Node3D"]
script = ExtResource("1_visual")
anim_path = NodePath("soldier/AnimationPlayer")

; Yawed 180 degrees because the Mixamo mesh faces +Z and Godot's forward is -Z.
; Measured, not guessed: tools/_debug_facing.gd reported the model's shoulder
; forward as (+0.01, +1.00) in the idle pose.
;
; This correction belongs HERE, at the asset boundary, rather than as a sign
; flip in _yaw_toward or face_toward: the movement and aim code is already
; correct in Godot's convention, and every consumer of unit facing (LOS, the
; flashlight cone in lighting_manager.gd) reads the unit node rather than the
; mesh. Negating things downstream would spread one asset quirk across gameplay.
;
; It must sit on this node and not on Visual: RifleMount hangs off the skeleton
; below, and has to inherit the same correction.
[node name="soldier" parent="." instance=ExtResource("2_soldier")]
transform = Transform3D(-1, 0, 0, 0, 1, 0, 0, 0, -1, 0, 0, 0)

; Driven from BOTH hands by weapon_mount.gd, not parented to one bone.
;
; This was a BoneAttachment3D on hand.R with a hand-solved Transform3D, which
; worked on the old generated rig because its clips were authored with the
; weapon in mind. Mixamo clips are separate mocap takes with no rifle in the
; actor's hand, so wrist roll varies between them: a mount solved exact in
; aim_hold left the barrel 43 deg off in idle and 21 deg off in run. Two hands
; are stable where one is not — see the script's header for the measurements.
;
; The mount writes its own global_transform, so the 0.01 scale on the Rig node
; no longer has to be compensated here; the rifle below is plain identity.
[node name="RifleMount" type="Node3D" parent="soldier/Rig/Skeleton3D" index="1"]
script = ExtResource("5_mount")

; Identity: the mount above already puts -Z down the barrel with the sights up,
; and rifle.glb is authored with its own -Z down the bore, so there is nothing
; left to correct here.
[node name="rifle" parent="soldier/Rig/Skeleton3D/RifleMount" instance=ExtResource("3_rifle")]

; No Muzzle node here any more: tools/gen_rifle.py exports one inside rifle.glb,
; so the barrel tip travels with the model. It used to be a hand-copied offset
; in this file, which meant every change to barrel length silently left the
; muzzle — and the shots and light that come off it — behind at the old spot.
; The light still hangs off the muzzle rather than the grip so the rifle's own
; mesh stops sitting inside the light and shadowing the beam it casts.
; spot_angle stays at 45 (a 90 degree cone) to match LightingManager's
; FLASHLIGHT_CONE_DEGREES — what you see lit is what the unit can actually see
; by. The angle attenuation concentrates that into a harsh centre with a dim
; spill out to the edge; the Beam below draws the ray itself.
; Still parented to the muzzle so the beam leaves the barrel, but aimed_light.gd
; sets top_level and re-imposes the UNIT's orientation every frame. The carry
; poses hold the rifle 80-85 degrees across the body, and a beam pointing there
; would contradict the tiles lighting_manager.gd says the unit lights.
[node name="Flashlight" type="SpotLight3D" parent="soldier/Rig/Skeleton3D/RifleMount/rifle/Muzzle"]
script = ExtResource("6_light")
light_color = Color(0.94, 0.96, 1, 1)
light_energy = 7.0
light_volumetric_fog_energy = 3.0
shadow_enabled = true
shadow_blur = 0.6
spot_range = 9.0
spot_angle = 45.0
spot_attenuation = 1.5
spot_angle_attenuation = 2.5

[node name="Beam" type="MeshInstance3D" parent="soldier/Rig/Skeleton3D/RifleMount/rifle/Muzzle/Flashlight"]
script = ExtResource("4_beam")
