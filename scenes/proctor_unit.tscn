[gd_scene load_steps=4 format=3 uid="uid://cproctorunit01"]

[ext_resource type="Script" path="res://scripts/proctor_unit.gd" id="1_script"]
[ext_resource type="Script" path="res://scripts/unit_visual.gd" id="2_visual"]

[sub_resource type="CapsuleShape3D" id="capsule_shape"]
radius = 0.3
height = 0.8

[node name="ProctorUnit" type="Node3D" groups=["enemy_units", "units"]]
script = ExtResource("1_script")
; The fastest unit in the faction, and the only one that outruns a soldier —
; a detector's whole job is to still be alive and moving when it reports.
move_speed = 5.0
; No plate at all. One solid hit should drop it; the design intent is that a
; Proctor is never what a fight is decided by, only what it brought with it.
armor_value = 0
evidence_scan_radius = 4
salvage_value = 3

; No weapon layer: this unit has no ranged attack and never acquires one, the
; same reason the swarm has none.
[node name="Visual" type="Node3D" parent="."]
script = ExtResource("2_visual")
layers = Array[StringName]([&"body", &"head", &"status"])
variant = &"proctor"
placeholder_style = &"machine"
has_light = false

[node name="Body" type="StaticBody3D" parent="."]
collision_layer = 2
collision_mask = 0

; Sits high, matching the hovering placeholder silhouette — a click has to land
; on where the drone is drawn, not on the empty deck under it.
[node name="Collision" type="CollisionShape3D" parent="Body"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.3, 0)
shape = SubResource("capsule_shape")

[node name="NameLabel" type="Label3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 2.2, 0)
billboard = 1
text = "Proctor"
