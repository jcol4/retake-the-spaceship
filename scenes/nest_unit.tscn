[gd_scene format=3 uid="uid://cnestunit001"]

[ext_resource type="Script" path="res://scripts/nest_unit.gd" id="1_script"]
[ext_resource type="Script" path="res://scripts/unit_visual.gd" id="2_visual"]

; A PICK volume, and unlike the worm's it is close to the art's real size: the
; nest measures 1.86 x 1.10 x 0.89 m (art_src/worm_spawn_scaled.blend, scaled to
; the merc's own 1.864 m). Boxed rather than capsuled because the thing lies
; flat -- a capsule tall enough to cover it would stand a metre of empty collider
; above a prone body. Kept a little under the art's footprint so it does not
; reach into the neighbouring tile it visually overhangs.
[sub_resource type="BoxShape3D" id="box_shape"]
size = Vector3(1.3, 0.9, 1.1)

[node name="NestUnit" type="Node3D" groups=["enemy_units", "units"]]
script = ExtResource("1_script")

; ONE layer, like the worm and the swarm: the whole nest is rendered flat in a
; single pass, so there is nothing to composite.
;
; canvas_height mirrors render_sprites.py CANVAS_HEIGHT. foot_anchor is row 28
; of 256. The mean over the eight idle facings — where this prop's base averages
; out — is row 34, and this is six pixels above it, which is the one place a
; character's anchor is set by something other than the art.
;
; The nest is wide and prone, so the facing whose near edge points at the camera
; projects ~30 px lower than the facing whose does not. At row 34 the near edge
; needed 0.62 m of ground-depth offset to clear the floor, and
; UnitVisual.GROUND_DEPTH_SAFETY caps that at 0.49 m so the nest cannot punch
; through cover half a tile away — leaving ~6 px of its near edge sliced off.
; Row 28 brings the requirement under the cap, at a cost of six pixels of lift
; that a prone blob with a 47 px facing spread cannot show.
;
; Not the minimum over all 192 frames either: anchoring there left the nest
; hovering over its tile in seven facings out of eight. Re-render and the mean
; moves; take it from the render log, then re-check it against the cap.
[node name="Visual" type="Node3D" parent="."]
script = ExtResource("2_visual")
layers = Array[StringName]([&"body"])
variant = &"nest"
canvas_height = 2.56
foot_anchor = Vector2(0.5, 0.890625)
has_light = false

[node name="Body" type="StaticBody3D" parent="."]
collision_layer = 2
collision_mask = 0

[node name="Collision" type="CollisionShape3D" parent="Body"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.45, 0)
shape = SubResource("box_shape")

[node name="NameLabel" type="Label3D" parent="."]
; Higher than a standing unit's label sits over its head, not lower. The art is
; only 0.89 m tall but it is 1.86 m WIDE, so at the camera's 35-degree pitch the
; sprite's top edge reads much further up the screen than its height suggests --
; at 1.1 the label landed on the body.
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.5, 0)
billboard = 1
text = "Nest"
