# Godot
.godot/
*.tmp

# Blender's own auto-backup of the previous save, not something to track
*.blend1

# Downloaded character FBX. Nothing in the pipeline reads one any more -- the
# rigs live in the art_src/*.blend files, which ARE tracked and are what a
# rebuild needs -- so this exists only to stop a fresh multi-hundred-MB download
# being committed if one is ever dropped in here to re-rig from.
art_src/*.fbx

# Python bytecode for the tools/ scripts. Was tracked, and had outlived three of
# the scripts it was compiled from -- a cache of files that no longer exist.
__pycache__/
*.pyc

# Render output: contact sheets, preview strips and gifs produced by the
# tools/ scripts (make_sprite_gif.py defaults --out here). ~27 MB across 146
# files, all regenerable from the blends in art_src/, so not worth versioning.
out/
