# Godot
.godot/
*.tmp

# Blender's own auto-backup of the previous save, not something to track
*.blend1

# Mixamo source FBX. The animation clips in art_src/anims/ ARE tracked (a few
# hundred KB each, and they're what a rebuild actually needs) -- this ignores
# only the character FBX sitting at the top of art_src/, which runs to 142 MB
# for a single body and is re-downloadable from mixamo.com in a minute.
# Note the single-level glob: art_src/*.fbx does not reach into anims/.
art_src/*.fbx

# Render output: contact sheets, preview strips and gifs produced by the
# tools/ scripts (make_sprite_gif.py defaults --out here). ~27 MB across 146
# files, all regenerable from the blends in art_src/, so not worth versioning.
out/
