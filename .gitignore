# Godot
.godot/
*.tmp

# Blender's own auto-backup of the previous save, not something to track
*.blend1

# Downloaded character FBX. Nothing in the pipeline reads one any more -- the
# rigs live in the art_src/*.blend files, which ARE tracked and are what a
# rebuild needs -- so this exists only to stop a fresh multi-hundred-MB download
# being committed if one is ever dropped in here to re-rig from.
art_src/*.fbx

# Python bytecode for the tools/ scripts. Was tracked, and had outlived three of
# the scripts it was compiled from -- a cache of files that no longer exist.
__pycache__/
*.pyc

# Raw Rhino/Blender room-tile sources (assets/room_tiles/source/) -- same
# reasoning as art_src/ above. These are multi-hundred-MB CAD exports with
# embedded 12800x7200 texture caches; nothing in the game reads them. The
# clean, scaled, texture-shrunk .glb modules built from them (via
# tools/export_room_modules.py) live in assets/room_tiles/modules/ instead,
# which IS tracked and is what MapBuilder actually instances.
assets/room_tiles/source/*.blend
assets/room_tiles/source/*.fbx

# Same raw-export problem, but dropped loose in assets/room_tiles/ itself
# instead of source/ -- caught once already (wall-*.blend, .fbx, .3dm and
# multi-ten-MB scaled-room-tiles pngs, ~2.7GB, got committed straight to
# origin/main). export_room_modules.py only ever reads assets/room_tiles/source/,
# so nothing here is loaded by anything -- if you're re-exporting, the raw file
# belongs in source/, not here.
assets/room_tiles/*.blend
assets/room_tiles/*.fbx
assets/room_tiles/*.3dm
assets/room_tiles/*.3dm.rhl
assets/room_tiles/scaled-room-tiles*

# Render output: contact sheets, preview strips and gifs produced by the
# tools/ scripts (make_sprite_gif.py defaults --out here). ~27 MB across 146
# files, all regenerable from the blends in art_src/, so not worth versioning.
out/
