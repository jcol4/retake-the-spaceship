# Placeholder furniture kits (ROOM_ASSETS_SOURCING.md). Listed per kit rather
# than as one room_tiles/** glob: room_tiles/modules/ holds PNGs committed
# before LFS, which a broad pattern would turn into "should have been pointers".
assets/room_tiles/kaykit_*/**/*.gltf              filter=lfs diff=lfs merge=lfs -text
assets/room_tiles/kaykit_*/**/*.bin               filter=lfs diff=lfs merge=lfs -text
assets/room_tiles/kaykit_*/**/*.png               filter=lfs diff=lfs merge=lfs -text
assets/room_tiles/quaternius_essentials/**/*.gltf filter=lfs diff=lfs merge=lfs -text
assets/room_tiles/quaternius_essentials/**/*.bin  filter=lfs diff=lfs merge=lfs -text
assets/room_tiles/quaternius_essentials/**/*.png  filter=lfs diff=lfs merge=lfs -text
assets/room_tiles/kenney_*/**/*.png               filter=lfs diff=lfs merge=lfs -text
assets/room_tiles/polypizza_*/**/*.png            filter=lfs diff=lfs merge=lfs -text
assets/room_tiles/floors/**/*.jpg                 filter=lfs diff=lfs merge=lfs -text

# Godot writes LF and rewrites these on every reimport. Pinned to LF so a
# reimport that changes nothing is no diff (core.autocrlf=true otherwise flags
# every one as modified). NOT gitignored: .import files carry each asset's uid
# and its import settings, and Godot expects them committed.
*.import   text eol=lf
*.tscn     text eol=lf
*.tres     text eol=lf
*.gd       text eol=lf
*.gdshader text eol=lf
*.uid      text eol=lf
*.godot    text eol=lf
